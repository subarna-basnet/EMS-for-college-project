# Optional. Tarra runs without any of these set.
# Identify this app when calling OpenStreetMap Nominatim.
TARRA_USER_AGENT=TarraPrototype/0.1 (local research prototype)

# Override public endpoints only if you are pointing at a mirror you operate.
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Optional landslide-detection model. Leave unset until a real model is running.
# Tarra POSTs JSON and expects { "probability": 0.0-1.0, "label"?: string, "model"?: string }.
# If the endpoint fails or returns nothing usable, the UI shows "data unavailable".
# It will not invent a confidence score.
# TARRA_MODEL_URL=http://127.0.0.1:8000/infer
